# Local browser configuration only. Use the local Supabase URL/key from
# `supabase status` when running the local stack, or a dedicated staging
# project when testing remotely. Never put a service_role/secret key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_local_or_staging_key
